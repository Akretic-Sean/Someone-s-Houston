# Shared Supabase project for email/password login and public neighborhood data.
# See ../../../docs/api.md. The publishable key is a public application credential
# and is safe in browser code. Never put an sb_secret_ key here.
VITE_SUPABASE_URL=https://hknzivrgihnqzvsafkkr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Listing Watch Agent. The browser POSTs a consented watch request here;
# scheduling, scraping and delivery happen server-side. Leave blank and the UI
# says it is not connected rather than failing silently.
VITE_LISTING_WATCH_WEBHOOK_URL=
