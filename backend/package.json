{
  "name": "hou-match-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "data:prepare": "npm run build && node --env-file-if-exists=.env dist/import-neighborhoods.js",
    "data:publish": "npm run build && node --env-file-if-exists=.env dist/import-neighborhoods.js --publish",
    "geo:prepare": "npm run build && node dist/prepare-boundaries.js && node dist/prepare-amenities.js",
    "geo:publish": "npm run build && node --env-file-if-exists=.env dist/publish-geodata.js",
    "groceries:prepare": "npm run build && node dist/prepare-groceries.js",
    "evidence:prepare": "npm run build && node --env-file-if-exists=.env dist/prepare-evidence.js",
    "evidence:publish": "npm run build && node --env-file-if-exists=.env dist/publish-evidence.js",
    "mcp": "node --env-file-if-exists=.env dist/mcp.js",
    "test:live": "npm run build && node --env-file-if-exists=.env test/live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
