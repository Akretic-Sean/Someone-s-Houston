# Houston public catalog reads do not need an API key.
HOUSTON_DATA_BASE_URL=https://data.houstontx.gov

# Fill these after the hou-match Supabase project exists.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-only credential for privileged ingestion jobs.
# Never expose this in frontend code or a public-prefixed environment variable.
SUPABASE_SECRET_KEY=
